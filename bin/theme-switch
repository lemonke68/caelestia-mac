#!/usr/bin/env python3
"""macOS port of ~/.config/caelestia/theme-switch.

    theme-switch            show current theme
    theme-switch list       list themes
    theme-switch <name>     apply themes/<name>

A theme is a Caelestia scheme (120 Material roles, same scheme.txt as on Arch)
plus a mode. Applying it rewrites:
    ~/.config/sketchybar/colors.sh      then reloads SketchyBar
    ~/.config/borders/bordersrc         and recolours the running borders
    ~/.config/kitty/theme.conf          then reloads every kitty
    ~/.config/zed/themes/caelestia.json Zed picks it up live
    macOS appearance                    dark / light from the theme mode
    wallpaper                           theme.json "wallpaper" via rice-wallpaper
    rice-shell                          reloads its colours
"""

import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
THEMES = ROOT / "themes"
TEMPLATES = ROOT / "templates"
HOME = Path.home()
CONFIG = HOME / ".config"
STATE = HOME / ".local/state/mac-rice/theme"


def run(*cmd: str) -> None:
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def load_scheme(path: Path) -> dict[str, str]:
    colours = {}
    for line in path.read_text().splitlines():
        parts = line.split()
        if len(parts) == 2:
            colours[parts[0]] = parts[1].lower()
    return colours


def argb(hex_rgb: str, alpha: str = "ff") -> str:
    return f"0x{alpha}{hex_rgb}"


def write_sketchybar(c: dict[str, str]) -> None:
    (CONFIG / "sketchybar/colors.sh").write_text(f"""#!/bin/bash
# Generated by mac-rice/bin/theme-switch — edit the scheme, not this file.

export BAR_COLOR={argb(c['surface'])}   # opaque: it is the top edge of the rice-shell frame
export ITEM_BG={argb(c['surfaceContainerHigh'])}
export ACCENT={argb(c['primary'])}
export ON_ACCENT={argb(c['onPrimary'])}
export TEXT={argb(c['onSurface'])}
export TEXT_DIM={argb(c['onSurfaceVariant'])}
export TEXT_FAINT={argb(c['outline'], '99')}
export RED={argb(c['error'])}
export TRANSPARENT=0x00000000

# Print a Nerd Font glyph by hex codepoint (macOS bash 3.2 printf lacks \\U).
glyph() {{ perl -CS -e "print chr(0x$1)"; }}
""")
    run("sketchybar", "--reload")


def write_borders(c: dict[str, str]) -> None:
    # Same values as Caelestia's activeWindowBorderColour / inactiveWindowBorderColour.
    active = argb(c["primary"], "e6")
    inactive = argb(c["onSurfaceVariant"], "11")
    path = CONFIG / "borders/bordersrc"
    path.write_text(f"""#!/bin/bash
# Generated by mac-rice/bin/theme-switch — edit the scheme, not this file.

options=(
    style=round
    width=2.0
    hidpi=on
    active_color={active}
    inactive_color={inactive}
)

borders "${{options[@]}}"
""")
    path.chmod(0o755)
    run("borders", f"active_color={active}", f"inactive_color={inactive}")


def write_kitty(c: dict[str, str]) -> None:
    palette = "\n".join(f"color{i} #{c[f'term{i}']}" for i in range(16))
    (CONFIG / "kitty/theme.conf").write_text(f"""# Generated by mac-rice/bin/theme-switch — edit the scheme, not this file.
background #{c['background']}
foreground #{c['onBackground']}
cursor #{c['primary']}
selection_background #{c['primaryContainer']}
selection_foreground #{c['onPrimaryContainer']}
active_border_color #{c['primary']}
inactive_border_color #{c['outlineVariant']}

{palette}
""")
    run("pkill", "-USR1", "-x", "kitty")


def write_zed(c: dict[str, str], mode: str) -> None:
    def fill(match: re.Match) -> str:
        name, _, form = match.group(1).strip().partition(".")
        if form == "hex" and name in c:
            return c[name]
        return match.group(0)

    text = (TEMPLATES / "zed.json").read_text()
    text = re.sub(r"\{\{\s*mode\s*\}\}", mode, text)
    text = re.sub(r"\{\{((?:(?!\{\{|\}\}).)*)\}\}", fill, text)
    out = CONFIG / "zed/themes/caelestia.json"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(text)


def set_appearance(mode: str) -> None:
    dark = "true" if mode == "dark" else "false"
    run("osascript", "-e",
        f'tell application "System Events" to tell appearance preferences to set dark mode to {dark}')


def set_wallpaper(meta: dict) -> None:
    if "wallpaper" in meta:
        run(str(ROOT / "bin/rice-wallpaper"), "set", meta["wallpaper"])


def apply(name: str) -> None:
    theme_dir = THEMES / name
    if not theme_dir.is_dir():
        sys.exit(f"нет темы {name!r}; см. theme-switch list")

    meta = json.loads((theme_dir / "theme.json").read_text())
    mode = meta["mode"]
    colours = load_scheme(theme_dir / "scheme.txt")

    # Written first: rice-shell and rice-picker read the current theme from it.
    STATE.parent.mkdir(parents=True, exist_ok=True)
    STATE.write_text(name)


    write_sketchybar(colours)
    write_borders(colours)
    write_kitty(colours)
    write_zed(colours, mode)
    set_appearance(mode)
    set_wallpaper(meta)
    run(str(ROOT / "bin/rice-shell"), "theme-changed")

    print(f"тема {name} ({mode}) применена")


def main() -> None:
    args = sys.argv[1:]
    if not args:
        print(STATE.read_text() if STATE.exists() else "тема не выбрана")
    elif args[0] == "list":
        for d in sorted(THEMES.iterdir()):
            if (d / "theme.json").exists():
                desc = json.loads((d / "theme.json").read_text()).get("description", "")
                print(f"{d.name:12} {desc}")
    else:
        apply(args[0])


if __name__ == "__main__":
    main()
