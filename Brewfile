# Everything the rice needs (install.sh: brew bundle). yabai comes separately (lib/yabai.sh):
# from Homebrew up to macOS 26, built from a fork on macOS 27.
tap "asmvik/formulae"
tap "felixkratz/formulae"
tap "ungive/media-control"

brew "asmvik/formulae/skhd"            # hotkeys
brew "felixkratz/formulae/sketchybar"  # top bar
brew "felixkratz/formulae/borders"     # window borders
brew "media-control"                   # now playing for the dashboard
brew "blueutil"                        # Bluetooth in the bar
brew "jq"                              # yabai scripts

cask "kitty"
cask "font-jetbrains-mono-nerd-font"
cask "font-material-symbols"
cask "font-rubik"
cask "font-google-sans-flex"
