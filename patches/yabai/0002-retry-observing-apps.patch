From 1ef9d3d3f8611e6962bcd5531779fb49b0534992 Mon Sep 17 00:00:00 2001
From: lemonke67 <igush55@gmail.com>
Date: Mon, 19 Oct 2026 12:47:44 +0300
Subject: [PATCH] Keep retrying apps that cannot be observed yet

An app launched while the system is not fully awake (at login, during a
dark wake with the lid closed) can refuse AX requests without returning
kAXErrorCannotComplete. yabai then never observed it again and its
windows stayed untiled until a restart. Retry with a growing delay, retry
apps that failed at startup, and pick up lost apps on wake and when they
come to the front.
---
 src/event_loop.c      | 43 +++++++++++++++++++++++++++++++++++++++++--
 src/process_manager.c |  1 +
 src/process_manager.h |  1 +
 src/window_manager.c  |  5 +++++
 4 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/src/event_loop.c b/src/event_loop.c
index 4630071..359191a 100644
--- a/src/event_loop.c
+++ b/src/event_loop.c
@@ -72,6 +72,24 @@ static void window_did_receive_focus(struct window_manager *wm, struct mouse_sta
 
 #pragma clang diagnostic push
 #pragma clang diagnostic ignored "-Wunused-parameter"
+//
+// NOTE(mac-rice): Running, launched, observable apps that yabai is not observing (see the retry
+// in APPLICATION_LAUNCHED): try them again from the start.
+//
+static void event_loop_observe_lost_applications(void)
+{
+    table_for (struct process *process, g_process_manager.process, {
+        if (__atomic_load_n(&process->terminated, __ATOMIC_RELAXED)) continue;
+        if (window_manager_find_application(&g_window_manager, process->pid)) continue;
+        if (!workspace_application_is_finished_launching(process)) continue;
+        if (!workspace_application_is_observable(process)) continue;
+
+        debug("%s: %s (%d) is not observed, retrying\n", __FUNCTION__, process->name, process->pid);
+        process->observe_attempts = 0;
+        event_loop_post(&g_event_loop, APPLICATION_LAUNCHED, process, 0);
+    })
+}
+
 static EVENT_HANDLER(APPLICATION_LAUNCHED)
 {
     struct process *process = context;
@@ -152,9 +170,19 @@ static EVENT_HANDLER(APPLICATION_LAUNCHED)
         application_destroy(application);
         debug("%s: could not observe notifications for %s (%d) (%d)\n", __FUNCTION__, process->name, process->pid, ax_retry);
 
-        if (ax_retry) {
+        //
+        // NOTE(mac-rice): An app launched while the system is not fully awake (at login, during a
+        // dark wake with the lid closed, e.g. an auto-update relaunch) can refuse AX requests for a
+        // while without returning kAXErrorCannotComplete. Upstream then gives up on it for good and
+        // its windows stay untiled until yabai restarts. Keep trying with a growing delay (~85 s in
+        // total); SYSTEM_WOKE and APPLICATION_FRONT_SWITCHED pick up whatever runs out of attempts.
+        //
+
+        int attempt = process->observe_attempts++;
+        if (ax_retry || attempt < 12) {
+            float delay = ax_retry ? 0.1f : fminf(0.5f * (float)(1 << attempt), 10.0f);
             __block ProcessSerialNumber psn = process->psn;
-            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 0.1f * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, delay * NSEC_PER_SEC), dispatch_get_main_queue(), ^{
                 struct process *_process = process_manager_find_process(&g_process_manager, &psn);
                 if (_process) event_loop_post(&g_event_loop, APPLICATION_LAUNCHED, _process, 0);
             });
@@ -163,6 +191,8 @@ static EVENT_HANDLER(APPLICATION_LAUNCHED)
         return;
     }
 
+    process->observe_attempts = 0;
+
     if (window_manager_find_lost_front_switched_event(&g_window_manager, process->pid)) {
         event_loop_post(&g_event_loop, APPLICATION_FRONT_SWITCHED, process, 0);
         window_manager_remove_lost_front_switched_event(&g_window_manager, process->pid);
@@ -353,6 +383,14 @@ static EVENT_HANDLER(APPLICATION_FRONT_SWITCHED)
 
     if (!application) {
         window_manager_add_lost_front_switched_event(&g_window_manager, process->pid);
+
+        // NOTE(mac-rice): The user switched to an app yabai lost; observe it now.
+        if (!__atomic_load_n(&process->terminated, __ATOMIC_RELAXED) &&
+            workspace_application_is_finished_launching(process) &&
+            workspace_application_is_observable(process)) {
+            process->observe_attempts = 0;
+            event_loop_post(&g_event_loop, APPLICATION_LAUNCHED, process, 0);
+        }
         return;
     }
 
@@ -1608,6 +1646,7 @@ static EVENT_HANDLER(SYSTEM_WOKE)
         window_manager_center_mouse(&g_window_manager, focused_window);
     }
 
+    event_loop_observe_lost_applications();
     event_signal_push(SIGNAL_SYSTEM_WOKE, NULL);
 }
 
diff --git a/src/process_manager.c b/src/process_manager.c
index 63f47df..26a3b83 100644
--- a/src/process_manager.c
+++ b/src/process_manager.c
@@ -62,6 +62,7 @@ static struct process *process_create(ProcessSerialNumber psn, pid_t pid)
     process->psn = psn;
     process->pid = pid;
     process->name = process_name;
+    process->observe_attempts = 0;
     __atomic_store_n(&process->terminated, false, __ATOMIC_RELEASE);
     __atomic_store_n(&process->ns_application, workspace_application_create_running_ns_application(process), __ATOMIC_RELEASE);
     return process;
diff --git a/src/process_manager.h b/src/process_manager.h
index 00989f4..89bb0cf 100644
--- a/src/process_manager.h
+++ b/src/process_manager.h
@@ -11,6 +11,7 @@ struct process
     char *name;
     void *ns_application;
     int policy;
+    int observe_attempts;
     bool volatile terminated;
 };
 
diff --git a/src/window_manager.c b/src/window_manager.c
index d8b5522..5e822c4 100644
--- a/src/window_manager.c
+++ b/src/window_manager.c
@@ -2747,6 +2747,11 @@ void window_manager_begin(struct space_manager *sm, struct window_manager *wm)
             } else {
                 application_unobserve(application);
                 application_destroy(application);
+
+                // NOTE(mac-rice): Apps still starting at login refuse AX for a moment; retry them
+                // through APPLICATION_LAUNCHED instead of leaving them unobserved for good.
+                debug("%s: could not observe %s (%d), retrying\n", __FUNCTION__, process->name, process->pid);
+                event_loop_post(&g_event_loop, APPLICATION_LAUNCHED, process, 0);
             }
         } else {
             debug("%s: %s (%d) is not observable, subscribing to activationPolicy changes\n", __FUNCTION__, process->name, process->pid);
-- 
